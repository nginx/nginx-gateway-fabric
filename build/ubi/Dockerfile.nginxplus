# syntax=docker/dockerfile:1.27

ARG NGINX_VERSION=1.31.3

FROM scratch AS nginx-files

# NGINX Plus repo and key files (must be provided at build time).
#
# nginx-plus.repo is held locally rather than fetched from
# https://cs.nginx.com/static/files/plus-9.repo, so the package source is
# pinned in the tree instead of changing without a commit.
ADD --link --chown=101:1001 https://nginx.org/keys/nginx_signing.key nginx_signing.key

# Render the repository definitions with the configured package hosts.
FROM alpine:3.24 AS nginx-repos

ARG NGINX_PLUS_PKG_HOST=pkgs.nginx.com
# Divergence: this image takes the agent from packages.nginx.org, the Alpine
# NGINX Plus image from pkgs.nginx.com. Preserved deliberately -- changing it
# would alter which packages a release is built from.
ARG NGINX_AGENT_PKG_HOST=packages.nginx.org
ARG NAP_WAF_PKG_HOST=pkgs.nginx.com

COPY build/ubi/repos/plus.repo /in/nginx-plus.repo
COPY build/ubi/repos/agent.repo /in/agent.repo
COPY build/ubi/repos/app-protect.repo /in/app-protect.repo

RUN mkdir -p /repos \
    && for repo in nginx-plus agent app-protect; do \
        sed -e "s|@NGINX_PLUS_PKG_HOST@|${NGINX_PLUS_PKG_HOST}|g" \
            -e "s|@NGINX_AGENT_PKG_HOST@|${NGINX_AGENT_PKG_HOST}|g" \
            -e "s|@NAP_WAF_PKG_HOST@|${NAP_WAF_PKG_HOST}|g" \
            "/in/${repo}.repo" > "/repos/${repo}.repo"; \
    done \
    # Fail rather than let a placeholder become an unexpected package source.
    && if grep -n '@[A-Z_]*_PKG_HOST@' /repos/*.repo; then \
        echo "error: unsubstituted package host placeholder in the lines above" >&2; \
        exit 1; \
    fi

# Configure nginx source for bindgen to generate Rust FFI bindings.
# glibc-based stages are required for ABI compatibility with UBI's runtime libraries.
FROM debian:bookworm-slim AS nginx-source

ARG NGINX_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc make libssl-dev libpcre2-dev zlib1g-dev wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz \
    && tar xzf nginx-${NGINX_VERSION}.tar.gz

RUN cd nginx-${NGINX_VERSION} && ./configure --with-compat --with-http_ssl_module

# Build the ai-guardrails Rust module against the configured nginx source.
FROM rust:slim-bookworm AS guardrails-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang libssl-dev libpcre2-dev zlib1g-dev make \
    && rm -rf /var/lib/apt/lists/*

ARG NGINX_VERSION

COPY --from=nginx-source /nginx-${NGINX_VERSION} /nginx-src

ENV NGINX_SOURCE_DIR=/nginx-src

WORKDIR /build
COPY internal/controller/nginx/modules/rust/ai-guardrails/ ./
RUN cargo build --release

FROM ghcr.io/nginx/dependencies/nginx-ubi:ubi10@sha256:ac243240bf6754ab61bfdbc811031bd01b4992cb52ca6eb19f1ed5a476df374a AS ubi10-packages

FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS ubi-nginx-plus

ARG NGINX_PLUS_VERSION=R37.1
ARG APP_PROTECT_VERSION=37.1+5.715
ARG INCLUDE_NAP_WAF=false

# renovate: datasource=github-tags depName=nginx/agent
ARG NGINX_AGENT_VERSION=v3.12.0
ARG NJS_DIR
ARG NGINX_CONF_DIR
ARG BUILD_AGENT

LABEL name="F5 NGINX Gateway Fabric NGINX Plus" \
	maintainer="kubernetes@nginx.com" \
	vendor="F5 NGINX" \
	summary="NGINX Gateway Fabric" \
	description="NGINX Gateway Fabric provides an implementation for the Gateway API using NGINX as the data plane." \
	org.nginx.ngf.image.build.agent="${BUILD_AGENT}" \
	io.k8s.description="NGINX Gateway Fabric provides an implementation for the Gateway API using NGINX as the data plane." \
	io.openshift.tags="nginx,gateway,kubernetes,openshift"

COPY --link --chown=101:1001 LICENSE /licenses/

# Install NGINX Plus and modules
RUN --mount=type=bind,from=nginx-repos,src=/repos/nginx-plus.repo,target=/etc/yum.repos.d/nginx-plus.repo \
    --mount=type=bind,from=nginx-repos,src=/repos/agent.repo,target=/etc/yum.repos.d/agent.repo \
    --mount=type=bind,from=nginx-repos,src=/repos/app-protect.repo,target=/etc/yum.repos.d/app-protect.repo \
    --mount=type=bind,from=nginx-files,src=nginx_signing.key,target=/tmp/nginx_signing.key \
    --mount=type=bind,from=ubi10-packages,src=/,target=/ubi-bin/ \
    --mount=type=secret,id=nginx-repo.crt,dst=/etc/ssl/nginx/nginx-repo.crt,mode=0644 \
	--mount=type=secret,id=nginx-repo.key,dst=/etc/ssl/nginx/nginx-repo.key,mode=0644 \
    # Import NGINX signing key
    rpm --import /tmp/nginx_signing.key \
    # Install c-ares from the dependencies image (contains required libs)
    && rpm -Uvh /ubi-bin/c-ares-*.rpm \
    # Create nginx user with consistent UID/GID.
    && microdnf --nodocs install -y shadow-utils ca-certificates \
    && groupadd -g 1001 nginx \
    && useradd -r -u 101 -g nginx -s /sbin/nologin -d /var/cache/nginx nginx \
    # Install NGINX Plus and modules (njs, otel)
    && microdnf --nodocs install -y nginx-plus-${NGINX_PLUS_VERSION,,} \
    && microdnf --nodocs install -y nginx-plus-module-njs-${NGINX_PLUS_VERSION,,} nginx-plus-module-otel-${NGINX_PLUS_VERSION,,} \
    # Optionally install NAP WAF
    && if [ "${INCLUDE_NAP_WAF}" = "true" ]; then \
           microdnf --nodocs install -y --enablerepo=app-protect-x-plus app-protect-module-plus-${APP_PROTECT_VERSION}*; \
       fi \
    # Install nginx-agent
    && microdnf --nodocs install -y nginx-agent-${NGINX_AGENT_VERSION#v}* \
    # Clean up
    && microdnf clean all \
    && rm -rf /var/cache/yum

# Configure directories and logging
RUN mkdir -p /var/run/nginx /usr/lib64/nginx/modules \
    # Forward request and error logs to docker log collector
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log
# Copy default html files to a writable location
RUN mkdir -p /etc/nginx/html \
    && cp /usr/share/nginx/html/* /etc/nginx/html/

# Set proper permissions for nginx user
RUN chown -R 101:1001 /etc/nginx /var/cache/nginx

# Copy configuration files and scripts
COPY build/entrypoint.sh /agent/entrypoint.sh
COPY ${NJS_DIR}/ /usr/lib64/nginx/modules/njs/
COPY --from=guardrails-builder /build/target/release/libai_guardrails.so /usr/lib64/nginx/modules/libai_guardrails.so
COPY ${NGINX_CONF_DIR}/nginx-plus.conf /etc/nginx/nginx.conf
COPY ${NGINX_CONF_DIR}/grpc-error-locations.conf /etc/nginx/grpc-error-locations.conf
COPY ${NGINX_CONF_DIR}/grpc-error-pages.conf /etc/nginx/grpc-error-pages.conf

# Create empty /run/.containerenv file so agent can identify that it's running in a container
RUN mkdir -p /run && touch /run/.containerenv

# Switch to non-root user
USER 101:1001

ENV USE_NAP_WAF=${INCLUDE_NAP_WAF}
ENTRYPOINT ["/agent/entrypoint.sh"]
