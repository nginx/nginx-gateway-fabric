# syntax=docker/dockerfile:1.28

# Bumped by .github/scripts/bump-nginx-versions.sh --nginx-oss
ARG NGINX_VERSION=1.31.7

FROM scratch AS nginx-files

# Repository and key files for UBI-based builds
ADD --link --chown=101:1001 https://nginx.org/keys/nginx_signing.key nginx_signing.key

# Render the repository definitions with the configured package hosts.
FROM alpine:3.24 AS nginx-repos

ARG NGINX_OSS_PKG_HOST=packages.nginx.org
ARG NGINX_AGENT_PKG_HOST=packages.nginx.org

COPY build/ubi/repos/nginx.repo /in/nginx.repo
COPY build/ubi/repos/agent.repo /in/agent.repo

RUN --mount=type=secret,id=nginx-pkg-hosts,required=false \
    if [ -f /run/secrets/nginx-pkg-hosts ]; then . /run/secrets/nginx-pkg-hosts; fi \
    && mkdir -p /repos \
    && for repo in nginx agent; do \
        sed -e "s|@NGINX_OSS_PKG_HOST@|${NGINX_OSS_PKG_HOST}|g" \
            -e "s|@NGINX_AGENT_PKG_HOST@|${NGINX_AGENT_PKG_HOST}|g" \
            "/in/${repo}.repo" > "/repos/${repo}.repo"; \
    done \
    && if [ -f /run/secrets/nginx-pkg-hosts ]; then \
        printf '%s\n' "sslclientcert=/etc/ssl/nginx/nginx-repo.crt" "sslclientkey=/etc/ssl/nginx/nginx-repo.key" \
            >> /repos/nginx.repo; \
    fi \
    # Fail rather than let a placeholder become an unexpected package source.
    && if grep -n '@[A-Z_]*_PKG_HOST@' /repos/*.repo; then \
        echo "error: unsubstituted package host placeholder in the lines above" >&2; \
        exit 1; \
    fi

FROM ghcr.io/nginx/dependencies/nginx-ubi:ubi10@sha256:07e03f99b46e377df6f8e5d2db88ef35da5d7830ec52117b5b944d0ce3181b91 AS ubi10-packages

FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS ubi-nginx

ARG NGINX_VERSION

# renovate: datasource=github-tags depName=nginx/agent
ARG NGINX_AGENT_VERSION=v3.12.2
ARG NJS_DIR
ARG NGINX_CONF_DIR
ARG BUILD_AGENT
ARG RUST_MODULES_DIR
ARG TARGETARCH

LABEL name="F5 NGINX Gateway Fabric NGINX OSS" \
	maintainer="kubernetes@nginx.com" \
	vendor="F5 NGINX" \
	summary="NGINX Gateway Fabric" \
	description="NGINX Gateway Fabric provides an implementation for the Gateway API using NGINX as the data plane." \
	org.nginx.ngf.image.build.agent="${BUILD_AGENT}" \
	io.k8s.description="NGINX Gateway Fabric provides an implementation for the Gateway API using NGINX as the data plane." \
	io.openshift.tags="nginx,gateway,kubernetes,openshift"

COPY --link --chown=101:1001 LICENSE /licenses/

# Install NGINX with packages
RUN --mount=type=bind,from=nginx-files,src=nginx_signing.key,target=/tmp/nginx_signing.key \
    --mount=type=bind,from=nginx-repos,src=/repos/nginx.repo,target=/etc/yum.repos.d/nginx.repo \
    --mount=type=bind,from=nginx-repos,src=/repos/agent.repo,target=/etc/yum.repos.d/agent.repo \
    --mount=type=bind,from=ubi10-packages,src=/,target=/ubi-bin/ \
    --mount=type=secret,id=nginx-repo.crt,dst=/etc/ssl/nginx/nginx-repo.crt,mode=0644,required=false \
    --mount=type=secret,id=nginx-repo.key,dst=/etc/ssl/nginx/nginx-repo.key,mode=0644,required=false \
    # Import NGINX signing key
    rpm --import /tmp/nginx_signing.key \
    # Install c-ares from the dependencies image (contains required libs)
    && rpm -Uvh /ubi-bin/c-ares-*.rpm \
    # Create nginx user with consistent UID/GID.
    && microdnf --nodocs install -y shadow-utils ca-certificates \
    && groupadd -g 1001 nginx \
    && useradd -r -u 101 -g nginx -s /sbin/nologin -d /var/cache/nginx nginx \
    # Install NGINX and modules including OTEL
    && microdnf --nodocs install -y nginx-${NGINX_VERSION} nginx-module-njs-${NGINX_VERSION}* nginx-module-otel-${NGINX_VERSION}* \
    # Install nginx-agent
    && microdnf --nodocs install -y nginx-agent-${NGINX_AGENT_VERSION#v}* \
    # Clean up
    && microdnf clean all \
    && rm -rf /var/cache/yum

# Configure directories and logging
RUN mkdir -p /var/run/nginx /usr/lib64/nginx/modules \
    # Forward request and error logs to docker log collector
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

# Set proper permissions for nginx user
RUN chown -R 101:1001 /etc/nginx /var/cache/nginx

# Copy configuration files and scripts
COPY build/entrypoint.sh /agent/entrypoint.sh
COPY ${NJS_DIR}/ /usr/lib64/nginx/modules/njs/
COPY ${RUST_MODULES_DIR}/${TARGETARCH}/libai_guardrails.so /usr/lib64/nginx/modules/libai_guardrails.so
COPY ${RUST_MODULES_DIR}/${TARGETARCH}/libinference.so /usr/lib64/nginx/modules/libinference.so
COPY ${NGINX_CONF_DIR}/nginx.conf /etc/nginx/nginx.conf
COPY ${NGINX_CONF_DIR}/grpc-error-locations.conf /etc/nginx/grpc-error-locations.conf
COPY ${NGINX_CONF_DIR}/grpc-error-pages.conf /etc/nginx/grpc-error-pages.conf

# Create empty /run/.containerenv file so agent can identify that it's running in a container
RUN mkdir -p /run && touch /run/.containerenv

# Switch to non-root user
USER 101:1001

ENTRYPOINT ["/agent/entrypoint.sh"]
