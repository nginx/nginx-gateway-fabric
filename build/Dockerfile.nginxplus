# syntax=docker/dockerfile:1.27

ARG NGINX_VERSION=1.31.3

FROM scratch AS nginx-files

# the following links can be replaced with local files if needed, i.e. ADD --chown=101:1001 <local_file> <container_file>
ADD --link --chown=101:1001 https://cs.nginx.com/static/keys/nginx_signing.rsa.pub nginx_signing.rsa.pub

# Configure nginx source for bindgen to generate Rust FFI bindings.
FROM alpine:3.24 AS nginx-source

ARG NGINX_VERSION

RUN apk add --no-cache gcc musl-dev openssl-dev pcre2-dev zlib-dev linux-headers perl make

RUN wget -q https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz \
    && tar xzf nginx-${NGINX_VERSION}.tar.gz

RUN cd nginx-${NGINX_VERSION} && ./configure --with-compat --with-http_ssl_module

# Build the ai-guardrails Rust module against the configured nginx source.
FROM rust:alpine AS guardrails-builder

# Pin clang20-dev: clang21's libclang.so cannot be dlopen'd on Alpine musl.
RUN apk add --no-cache musl-dev openssl-dev perl make \
    pcre2-dev zlib-dev linux-headers clang20-dev

ARG NGINX_VERSION

COPY --from=nginx-source /nginx-${NGINX_VERSION} /nginx-src

ENV NGINX_SOURCE_DIR=/nginx-src
ENV RUSTFLAGS="-C target-feature=-crt-static"

WORKDIR /build
COPY internal/controller/nginx/modules/rust/ai-guardrails/ ./
RUN cargo build --release

FROM alpine:3.24

ARG NGINX_PLUS_VERSION=R37.1
# renovate: datasource=github-tags depName=nginx/agent
ARG NGINX_AGENT_VERSION=v3.12.1
ARG APP_PROTECT_VERSION=37.1.5.715
ARG INCLUDE_NAP_WAF=false
ARG NJS_DIR
ARG NGINX_CONF_DIR
ARG BUILD_AGENT

ARG NGINX_PLUS_PKG_HOST=pkgs.nginx.com
# Divergence: this image takes the agent from pkgs.nginx.com, every other from
# packages.nginx.org. Preserved deliberately -- changing it would alter which
# packages a release is built from.
ARG NGINX_AGENT_PKG_HOST=pkgs.nginx.com
ARG NAP_WAF_PKG_HOST=pkgs.nginx.com

RUN apk upgrade --no-cache zlib

# The package hosts can also be overridden by the optional nginx-pkg-hosts
# secret, a file of NAME=host lines, which wins over the build args. A release
# builds from an internal package host that must not appear in the published
# image: a secret, unlike a build arg, is recorded in neither the image
# history nor its provenance. With the secret, the package sources go to a
# file of their own that apk reads for this install only, so the image's
# /etc/apk/repositories does not name them either; without it, they are
# appended to /etc/apk/repositories as they always have been.
RUN --mount=type=secret,id=nginx-repo.crt,dst=/etc/apk/cert.pem,mode=0644 \
    --mount=type=secret,id=nginx-repo.key,dst=/etc/apk/cert.key,mode=0644 \
    --mount=type=secret,id=nginx-pkg-hosts,required=false \
    --mount=type=bind,from=nginx-files,src=nginx_signing.rsa.pub,target=/etc/apk/keys/nginx_signing.rsa.pub \
    addgroup -g 1001 -S nginx \
    && adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx \
    && repos=/etc/apk/repositories \
    && if [ -f /run/secrets/nginx-pkg-hosts ]; then \
           . /run/secrets/nginx-pkg-hosts \
           && repos=/tmp/repositories \
           && cp /etc/apk/repositories "${repos}"; \
       fi \
    && alpine="v$(grep -E -o '^[0-9]+\.[0-9]+' /etc/alpine-release)" \
    && printf "%s\n" "https://${NGINX_PLUS_PKG_HOST}/plus/${NGINX_PLUS_VERSION}/alpine/${alpine}/main" >> "${repos}" \
    && printf "%s\n" "https://${NGINX_AGENT_PKG_HOST}/nginx-agent/alpine/${alpine}/main" >> "${repos}" \
    && if [ "${INCLUDE_NAP_WAF}" = "true" ]; then \
           printf "%s\n" "https://${NAP_WAF_PKG_HOST}/app-protect-x-plus/alpine/${alpine}/main" >> "${repos}" \
           && apk add --no-cache --repositories-file "${repos}" app-protect-module-plus~=${APP_PROTECT_VERSION}; \
       fi \
    && apk add --no-cache --repositories-file "${repos}" nginx-plus nginx-plus-module-njs nginx-plus-module-otel nginx-agent=${NGINX_AGENT_VERSION#v} \
    && rm -f /tmp/repositories

RUN apk add --no-cache bash ca-certificates \
    && mkdir -p /usr/lib/nginx/modules \
    # forward request and error logs to docker log collector
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

COPY build/entrypoint.sh /agent/entrypoint.sh
COPY ${NJS_DIR}/ /usr/lib/nginx/modules/njs/
COPY --from=guardrails-builder /build/target/release/libai_guardrails.so /usr/lib/nginx/modules/libai_guardrails.so
COPY ${NGINX_CONF_DIR}/nginx-plus.conf /etc/nginx/nginx.conf
COPY ${NGINX_CONF_DIR}/grpc-error-locations.conf /etc/nginx/grpc-error-locations.conf
COPY ${NGINX_CONF_DIR}/grpc-error-pages.conf /etc/nginx/grpc-error-pages.conf

# Create empty /run/.containerenv file so agent can identify that it's running in a container
RUN mkdir -p /run && touch /run/.containerenv

RUN chown -R 101:1001 /etc/nginx /var/cache/nginx /var/lib/nginx

USER 101:1001

LABEL org.nginx.ngf.image.build.agent="${BUILD_AGENT}"

ENV USE_NAP_WAF=${INCLUDE_NAP_WAF}
ENTRYPOINT ["/agent/entrypoint.sh"]
