# syntax=docker/dockerfile:1.25

FROM scratch AS nginx-files

# the following links can be replaced with local files if needed, i.e. ADD --chown=101:1001 <local_file> <container_file>
ADD --link --chown=101:1001 https://cs.nginx.com/static/keys/nginx_signing.rsa.pub nginx_signing.rsa.pub

# Default no-op guardrails-builder stage (empty). When INCLUDE_GUARDRAILS=true,
# the Makefile supplies --build-context which overrides this with the real image.
FROM scratch AS guardrails-builder

FROM alpine:3.23

# renovate: datasource=github-tags depName=nginx/nginx extractVersion=^release-(?<version>.+)$
ARG NGINX_VERSION=1.31.3

# renovate: datasource=github-tags depName=nginx/agent
ARG NGINX_AGENT_VERSION=v3.11.2
ARG NJS_DIR
ARG NGINX_CONF_DIR
ARG BUILD_AGENT
ARG INCLUDE_GUARDRAILS=false

RUN apk update && apk upgrade --no-cache curl libpng

RUN --mount=type=bind,from=nginx-files,src=nginx_signing.rsa.pub,target=/etc/apk/keys/nginx_signing.rsa.pub \
    addgroup -g 1001 -S nginx \
    && adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx \
    && printf "%s\n" "https://packages.nginx.org/nginx/mainline/alpine/v$(egrep -o '^[0-9]+\.[0-9]+' /etc/alpine-release)/main" >> /etc/apk/repositories \
    && printf "%s\n" "https://packages.nginx.org/nginx-agent/alpine/v$(egrep -o '^[0-9]+\.[0-9]+' /etc/alpine-release)/main" >> /etc/apk/repositories \
    && apk add --no-cache nginx~=${NGINX_VERSION} nginx-module-njs nginx-module-otel nginx-agent=${NGINX_AGENT_VERSION#v}

# ca-certificates provides the system trust store used by the AI Guardrails
# module's HTTPS client (rustls verifies against the OS/native roots).
RUN apk add --no-cache bash ca-certificates \
    && mkdir -p /usr/lib/nginx/modules \
    # forward request and error logs to docker log collector
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

COPY build/entrypoint.sh /agent/entrypoint.sh
COPY ${NJS_DIR}/ /usr/lib/nginx/modules/njs/
COPY ${NGINX_CONF_DIR}/nginx.conf /etc/nginx/nginx.conf
COPY ${NGINX_CONF_DIR}/grpc-error-locations.conf /etc/nginx/grpc-error-locations.conf
COPY ${NGINX_CONF_DIR}/grpc-error-pages.conf /etc/nginx/grpc-error-pages.conf

# Optionally install the AI Guardrails dynamic module.
# When INCLUDE_GUARDRAILS=true, the Makefile supplies:
#   --build-context guardrails-builder=docker-image://guardrails-alpine:latest
#   --build-arg INCLUDE_GUARDRAILS=true
# which overrides the empty no-op guardrails-builder stage above.
RUN --mount=type=bind,from=guardrails-builder,source=/,target=/guardrails-src \
    if [ "${INCLUDE_GUARDRAILS}" = "true" ] && [ -f /guardrails-src/out/libai_guardrails.so ]; then \
        cp /guardrails-src/out/libai_guardrails.so /usr/lib/nginx/modules/libai_guardrails.so; \
    fi

# Create empty /run/.containerenv file so agent can identify that it's running in a container
RUN mkdir -p /run && touch /run/.containerenv

RUN chown -R 101:1001 /etc/nginx /var/cache/nginx

LABEL org.nginx.ngf.image.build.agent="${BUILD_AGENT}"

USER 101:1001

ENTRYPOINT ["/agent/entrypoint.sh"]
