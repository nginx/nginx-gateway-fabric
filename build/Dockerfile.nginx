# syntax=docker/dockerfile:1.28

# Bumped by .github/scripts/bump-nginx-versions.sh --nginx-oss
ARG NGINX_VERSION=1.31.7

FROM scratch AS nginx-files

# the following links can be replaced with local files if needed, i.e. ADD --chown=101:1001 <local_file> <container_file>
ADD --link --chown=101:1001 https://cs.nginx.com/static/keys/nginx_signing.rsa.pub nginx_signing.rsa.pub

FROM alpine:3.24

ARG NGINX_VERSION

# renovate: datasource=github-tags depName=nginx/agent
ARG NGINX_AGENT_VERSION=v3.12.2
ARG NJS_DIR
ARG NGINX_CONF_DIR
ARG BUILD_AGENT
ARG RUST_MODULES_DIR
ARG TARGETARCH

ARG NGINX_OSS_PKG_HOST=packages.nginx.org
ARG NGINX_AGENT_PKG_HOST=packages.nginx.org

RUN apk update && apk upgrade --no-cache curl libcrypto3 libssl3 zlib

RUN --mount=type=secret,id=nginx-pkg-hosts,required=false \
    --mount=type=secret,id=nginx-repo.crt,dst=/etc/apk/cert.pem,mode=0644,required=false \
    --mount=type=secret,id=nginx-repo.key,dst=/etc/apk/cert.key,mode=0644,required=false \
    --mount=type=bind,from=nginx-files,src=nginx_signing.rsa.pub,target=/etc/apk/keys/nginx_signing.rsa.pub \
    addgroup -g 1001 -S nginx \
    && adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx \
    && repos=/etc/apk/repositories \
    && if [ -f /run/secrets/nginx-pkg-hosts ]; then \
           . /run/secrets/nginx-pkg-hosts \
           && repos=/tmp/repositories \
           && cp /etc/apk/repositories "${repos}"; \
       fi \
    && alpine="v$(grep -E -o '^[0-9]+\.[0-9]+' /etc/alpine-release)" \
    && printf "%s\n" "https://${NGINX_OSS_PKG_HOST}/nginx/mainline/alpine/${alpine}/main" >> "${repos}" \
    && printf "%s\n" "https://${NGINX_AGENT_PKG_HOST}/nginx-agent/alpine/${alpine}/main" >> "${repos}" \
    && apk add --no-cache --repositories-file "${repos}" nginx~=${NGINX_VERSION} nginx-module-njs nginx-module-otel nginx-agent=${NGINX_AGENT_VERSION#v} \
    && rm -f /tmp/repositories

RUN apk add --no-cache bash ca-certificates \
    && mkdir -p /usr/lib/nginx/modules \
    # forward request and error logs to docker log collector
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

COPY build/entrypoint.sh /agent/entrypoint.sh
COPY ${NJS_DIR}/ /usr/lib/nginx/modules/njs/
COPY ${RUST_MODULES_DIR}/${TARGETARCH}/libai_guardrails.so /usr/lib/nginx/modules/libai_guardrails.so
COPY ${RUST_MODULES_DIR}/${TARGETARCH}/libinference.so /usr/lib/nginx/modules/libinference.so
COPY ${NGINX_CONF_DIR}/nginx.conf /etc/nginx/nginx.conf
COPY ${NGINX_CONF_DIR}/grpc-error-locations.conf /etc/nginx/grpc-error-locations.conf
COPY ${NGINX_CONF_DIR}/grpc-error-pages.conf /etc/nginx/grpc-error-pages.conf

# Create empty /run/.containerenv file so agent can identify that it's running in a container
RUN mkdir -p /run && touch /run/.containerenv

RUN chown -R 101:1001 /etc/nginx /var/cache/nginx

LABEL org.nginx.ngf.image.build.agent="${BUILD_AGENT}"

USER 101:1001

ENTRYPOINT ["/agent/entrypoint.sh"]
